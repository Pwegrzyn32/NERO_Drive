{
  "name": "nero-drive",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:video": "ffmpeg -y -i source-images/drive.mp4 -vf \"scale='min(1280,iw)':-2\" -c:v libx264 -crf 28 -preset slow -movflags +faststart -c:a aac -b:a 96k public/images/drive.mp4",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:nero-drive": "node dist/nero-drive/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.3",
    "@emailjs/browser": "^4.4.1",
    "express": "^5.1.0",
    "ffmpeg": "^0.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "@netlify/angular-runtime": "^4.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "prettier": "^3.8.1",
    "sharp": "^0.35.2",
    "typescript": "~6.0.2"
  }
}
